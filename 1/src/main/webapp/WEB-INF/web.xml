<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee 
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>24110032_TruongGiaKiet_BT09.11.2026</display-name>

    <!-- ==================================================================== -->
    <!-- 1. UTF-8 Character Encoding Filter                                   -->
    <!-- Enforces UTF-8 character encoding for all incoming requests and      -->
    <!-- outgoing responses to preserve Vietnamese diacritics.                -->
    <!-- ==================================================================== -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>org.apache.catalina.filters.SetCharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
        <init-param>
            <param-name>ignore</param-name>
            <param-value>false</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ==================================================================== -->
    <!-- 2. Session Configuration                                             -->
    <!-- 30-minute inactivity timeout, HttpOnly cookies for session security  -->
    <!-- ==================================================================== -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- ==================================================================== -->
    <!-- 3. Welcome File List                                                 -->
    <!-- Directs root access to /login servlet, falling back to views/login.jsp-->
    <!-- ==================================================================== -->
    <welcome-file-list>
        <welcome-file>login</welcome-file>
        <welcome-file>views/login.jsp</welcome-file>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
